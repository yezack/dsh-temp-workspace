{
  "name": "@yezack/dsh-temp-workspace",
  "version": "0.2.2",
  "description": "DSH web client plugin: a temporary workspace (临时工作区) — every conversation it contains is deleted at the next Harness restart (immediately or after a delay), optionally behind a confirm dialog. Temp workspaces are named after their creation moment and grouped under one collapsible 临时工作区 row inside the sidebar Workspace list; also adds a small icon beside \"Add workspace\" and a Settings -> Plugins card.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "wjj-8283 <wlw20070926@outlook.com>",
  "homepage": "https://github.com/yezack/dsh-temp-workspace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yezack/dsh-temp-workspace.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness-plugin",
    "workspace",
    "temporary-workspace",
    "temp-workspace",
    "session",
    "cleanup"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "check": "node build.mjs --check",
    "prepublishOnly": "node build.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "workspaces",
        "uiWorkspace",
        "sessions",
        "slots",
        "locale"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "main": "./lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "bugs": {
    "url": "https://github.com/yezack/dsh-temp-workspace/issues"
  }
}
